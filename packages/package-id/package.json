{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/package-id",
  "version": "0.0.2",
  "description": "Package URLs (purl), the purl of each OSV ecosystem, the version order of each ecosystem and version ranges (vers). Plain functions with no fetch.",
  "keywords": [
    "purl",
    "package-url",
    "osv",
    "sbom",
    "typescript"
  ],
  "homepage": "https://github.com/mark1russell7/package-id#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/package-id/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/package-id.git",
    "directory": "packages/package-id"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
